# 공개(메인·대회) API — next.config.js 기본값: http://localhost:8080
NEXT_PUBLIC_API_BASE_URL_USER=http://localhost:8080

# 관리자 API
NEXT_PUBLIC_API_BASE_URL_ADMIN=http://localhost:8080

# none | cookie | bearer (기본 cookie)
# NEXT_PUBLIC_AUTH_MODE=cookie

# 회원가입 SMS (서버 Route Handler — 로컬에서 SMS 안 쓰면 비워 둬도 됨)
# NCP_SERVICE_ID=
# NCP_ACCESS_KEY=
# NCP_SECRET_KEY=
